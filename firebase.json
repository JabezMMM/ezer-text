{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "venv",
        ".venv",
        "**/*.pyc",
        "__pycache__",
        ".env"
      ]
    }
  ],
  "hosting": {
    "site": "ezer-text-site",
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/generate",
        "function": "generate"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5005
    },
    "hosting": {
      "port": 5006
    },
    "ui": {
      "enabled": false
    }
  }
}